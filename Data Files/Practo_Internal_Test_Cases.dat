   <data>User+Registration+%26+Login TC_REG_001 Login+with+valid+registered+mobile+number+and+password 1.+Open+%60https%3A%2F%2Fwww.practo.com%2F%60.%0D%0A2.+Click+Login%2FSign+up.%0D%0A3.+Enter+the+registered+mobile+number.%0D%0A4.+Choose+Password+login+%28if+prompted%29.%0D%0A5.+Enter+password.%0D%0A6.+Click+Login%2FContinue. URL%3A+https%3A%2F%2Fwww.practo.com%2F%3B+Mobile%3A+7071627000%3B+Password%3A+Global%401710 User+is+logged+in+successfully%3B+account%2Fuser+menu+is+visible+and+user+is+redirected+to+the+intended+page%2Fhome+without+error. 7071627000 Global%401710</data>
   <data>User+Registration+%26+Login TC_REG_002 Reject+login+with+valid+mobile+number+and+wrong+password 1.+Open+Practo+home+page.%0A2.+Click+Login%2FSign+up.%0A3.+Enter+registered+mobile+number.%0A4.+Choose+Password+login+%28if+prompted%29.%0A5.+Enter+an+incorrect+password.%0A6.+Click+Login%2FContinue. Mobile%3A+7071627000%3B+Password%3A+Global%401710%23+%28invalid%29 System+shows+a+clear+authentication+error+%28e.g.%2C+invalid+credentials%29%3B+user+remains+logged+out. 7071627000 Global%401710%23</data>
   <data>Doctor+Search+%26+Filters TC_SRCH_001 Search+doctors+by+specialty+and+city+using+autosuggest 1.+Open+%60https%3A%2F%2Fwww.practo.com%2F%60.%0A2.+In+the+search%2C+select+city%2Flocation.%0A3.+Enter+a+specialty+and+pick+an+autosuggest+option.%0A4.+Submit+search. City%3A+Bengaluru%3B+Specialty%3A+Dermatologist Search+results+page+lists+relevant+doctors%2Fclinics+for+the+selected+specialty+and+city%3B+selected+chips%2Flabels+reflect+the+chosen+values. null null</data>
