# Build from repository root:
#   docker compose build global-settings
#   docker build -f Corp.microservice.custom-charges-globalSettings/Dockerfile .

# -------- Build persistence-layer (published to image-local Maven repo) --------
FROM gradle:8.14-jdk21 AS persistence-builder

WORKDIR /persistence
COPY Corp.microservice.custom-charges-persistence/ .
RUN ./gradlew publishToMavenLocal -x test -x jacocoTestCoverageVerification --no-daemon

# -------- Build global-settings --------
FROM gradle:8.14-jdk21 AS builder

WORKDIR /workspace
COPY --from=persistence-builder /root/.m2/repository/com/customcharge/persistence-layer \
    /root/.m2/repository/com/customcharge/persistence-layer
COPY Corp.microservice.custom-charges-globalSettings/ .
# Reuse Gradle wrapper from persistence (this service has no gradlew in repo)
COPY --from=persistence-builder /persistence/gradlew ./gradlew
COPY --from=persistence-builder /persistence/gradle ./gradle
RUN chmod +x gradlew && ./gradlew bootJar -x test --no-daemon --build-cache

# -------- Runtime --------
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

ARG git_commit_id
ARG build_version
LABEL git_commit_id=$git_commit_id
LABEL build_version=$build_version

RUN addgroup -S globalsettings && adduser -S globalsettings -G globalsettings

COPY --from=builder /workspace/build/libs/*.jar /app/app.jar

USER globalsettings:globalsettings

# Overridden at runtime via SERVER_PORT (docker-compose uses 8000)
ENV SERVER_PORT=8000
EXPOSE 8000

ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
