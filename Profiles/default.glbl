   <GlobalVariableEntity>
      <description></description>
      <initValue>'https://dev-cc.aramex.com/customs/upload-charges'</initValue>
      <name>UPLOAD_CHARGES_URL</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Legacy export path hint (prefix only). Prefer HISTORY_EXPORT_* variables.</description>
      <initValue>'C:\\Users\\Aditi Singh\\Downloads\\Global-Settings-History-'</initValue>
      <name>EXPORT_FILE</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Folder where Global Settings History export .csv is saved (TC_GS_FUNC_067+).</description>
      <initValue>'C:\\Users\\Aditi Singh\\Downloads'</initValue>
      <name>HISTORY_EXPORT_DOWNLOADS_DIR</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Expected substring in exported History Excel file name.</description>
      <initValue>'Global-Settings-History_'</initValue>
      <name>HISTORY_EXPORT_FILE_NAME_PREFIX</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>'https://dev-cc.aramex.com/customs-management/ap-management'</initValue>
      <name>AP_URL</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>'https://dev-cc.aramex.com/customs-management/ar-management'</initValue>
      <name>AR_URL</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>IMAP host for Global Settings notification emails. Falls back to MS_IMAP_HOST when empty.</description>
      <initValue>''</initValue>
      <name>GS_EMAIL_IMAP_HOST</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>IMAP port for Global Settings notification emails. Falls back to MS_IMAP_PORT when empty.</description>
      <initValue>''</initValue>
      <name>GS_EMAIL_IMAP_PORT</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Mailbox that receives Global Settings notification emails. Falls back to MS_IMAP_USER when empty.</description>
      <initValue>''</initValue>
      <name>GS_EMAIL_IMAP_USER</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>IMAP password for notification mailbox. Falls back to MS_IMAP_PASSWORD. Never commit secrets.</description>
      <initValue>''</initValue>
      <name>GS_EMAIL_IMAP_PASSWORD</name>
      <protected>true</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Case-insensitive substring matched against notification email From header (e.g. noreply).</description>
      <initValue>'noreply'</initValue>
      <name>GS_EMAIL_SENDER_CONTAINS</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Expected subject fragment for Global Setting Created notification.</description>
      <initValue>'Global Setting Created'</initValue>
      <name>GS_EMAIL_SUBJECT_CREATE</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Max seconds to poll IMAP while waiting for a Global Settings notification email.</description>
      <initValue>'120'</initValue>
      <name>GS_EMAIL_FETCH_MAX_WAIT_SECONDS</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Seconds between IMAP poll attempts for notification email verification.</description>
      <initValue>'10'</initValue>
      <name>GS_EMAIL_FETCH_POLL_SECONDS</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Wait time for negative email tests (CANCEL — no email should arrive).</description>
      <initValue>'60'</initValue>
      <name>GS_EMAIL_NEGATIVE_WAIT_SECONDS</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
