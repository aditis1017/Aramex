      <initValue>'90'</initValue>
      <name>MS_OTP_FETCH_MAX_WAIT_SECONDS</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Seconds between IMAP poll attempts.</description>
      <initValue>'5'</initValue>
      <name>MS_OTP_FETCH_POLL_SECONDS</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
