   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Microsoft Entra ID â€” sign-in email (UPN). Required for login unless you pass the email argument or set MS_AUTO_FETCH_OTP_FROM_EMAIL=true and use the same UPN in MS_IMAP_USER. Set in your local Katalon profile; leave empty in shared repos.</description>
      <initValue>'SVC_CCI@aramex.com'</initValue>
      <name>MS_LOGIN_EMAIL</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Microsoft password if your tenant shows password after email. Prefer empty + device code / manual OTP. Never commit secrets.</description>
      <initValue>''</initValue>
      <name>MS_LOGIN_PASSWORD</name>
      <protected>true</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>One-time email/Authenticator code when required. For local runs only; leave empty to use IMAP auto-fetch (MS_AUTO_FETCH_OTP_FROM_EMAIL) or manual browser entry.</description>
      <initValue>''</initValue>
      <name>MS_VERIFICATION_CODE</name>
      <protected>true</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>If true and MS_VERIFICATION_CODE is empty, polls IMAP (MS_IMAP_*) for a recent Microsoft-style OTP when the OTP field appears.</description>
      <initValue>'false'</initValue>
      <name>MS_AUTO_FETCH_OTP_FROM_EMAIL</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>IMAP server host for OTP and notification emails (e.g. outlook.office365.com). Used when GS_EMAIL_IMAP_HOST is empty.</description>
      <initValue>'outlook.office365.com'</initValue>
      <name>MS_IMAP_HOST</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>IMAP SSL port (usually 993).</description>
      <initValue>'993'</initValue>
      <name>MS_IMAP_PORT</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>IMAP username (mailbox address). When empty, MS_LOGIN_EMAIL is used for notification email tests.</description>
      <initValue>''</initValue>
      <name>MS_IMAP_USER</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>IMAP password or app password. Never commit real values; use Profile override locally.</description>
      <initValue>''</initValue>
      <name>MS_IMAP_PASSWORD</name>
      <protected>true</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Case-insensitive substring matched against the message From header (e.g. microsoft).</description>
      <initValue>'microsoft'</initValue>
      <name>MS_OTP_SENDER_CONTAINS</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Only consider messages received within this many minutes when searching for an OTP.</description>
      <initValue>'10'</initValue>
      <name>MS_OTP_LOOKBACK_MINUTES</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Optional Java regex with one capturing group for the OTP digits. Leave empty to use built-in Microsoft-style patterns.</description>
